@model IEnumerable<LocalLinker.Models.Service>
@{
    ViewData["Title"] = "Manage Services";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="mb-3">Services</h2>

<a href="@Url.Action("CreateService", "Admin")" class="btn btn-success mb-3">
    <i class="fa fa-plus"></i> Add New Service
</a>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Service ID</th>
            <th>Service Name</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var service in Model)
        {
            <tr>
                <td>@service.Service_id</td>
                <td>@service.Service_name</td>

                <!-- STATUS -->
                <td>
                    @if (service.IsActive == true)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inactive</span>
                    }
                </td>

                <!-- ACTION BUTTON -->
                <td>
                    <a class="btn btn-sm btn-primary"
                       href="@Url.Action("EditService", new { id = service.Service_id })">
                        <i class="fa fa-edit"></i> Edit
                    </a>

                    @if (service.IsActive == true)
                    {
                        <!-- ON → OFF -->
                        <a class="btn btn-sm btn-warning"
                           href="@Url.Action("DeactivateService", new { id = service.Service_id })"
                           onclick="return confirm('Deactivate this service?');">
                            <i class="fa fa-toggle-off"></i> Deactivate
                        </a>
                    }
                    else
                    {
                        <!-- OFF → ON -->
                        <a class="btn btn-sm btn-success"
                           href="@Url.Action("ActivateService", new { id = service.Service_id })"
                           onclick="return confirm('Activate this service?');">
                            <i class="fa fa-toggle-on"></i> Activate
                        </a>
                    }
                </td>
            </tr>
        }
    </tbody>

</table>
