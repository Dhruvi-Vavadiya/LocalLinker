@model LocalLinker.Models.Service
@{
    ViewData["Title"] = "Add Service";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h2>Add New Service</h2>

<form asp-action="CreateService" method="post" enctype="multipart/form-data" class="mt-3">
    <!-- Service Name -->
    <div class="mb-3">
        <label asp-for="Service_name" class="form-label"></label>
        <input asp-for="Service_name" class="form-control" />
        <span asp-validation-for="Service_name" class="text-danger"></span>
    </div>

    <!-- Service Description -->
    <div class="mb-3">
        <label asp-for="description" class="form-label"></label>
        <textarea asp-for="description" class="form-control" rows="3"></textarea>
        <span asp-validation-for="description" class="text-danger"></span>
    </div>

    <!-- Service Price -->
    <div class="mb-3">
        <label asp-for="price" class="form-label"></label>
        <input asp-for="price" type="number" step="0.01" class="form-control" />
        <span asp-validation-for="price" class="text-danger"></span>
    </div>

    <!-- Service Image -->
    <div class="mb-3">
        <label asp-for="Image" class="form-label">Upload Image</label>
        <input asp-for="Image" type="file" class="form-control" />
        <span asp-validation-for="Image" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">Save</button>
    <a asp-action="Services" class="btn btn-secondary">Cancel</a>
</form>
