<!-- JavaScript for Interactive Elements -->
<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Skill Level Selection
        const skillItems = document.querySelectorAll('.skill-level-item');
        skillItems.forEach(item => {
            item.addEventListener('click', function() {
                skillItems.forEach(i => i.classList.remove('selected'));
                this.classList.add('selected');
            });
        });

        // Day Checkbox Selection
        const dayCheckboxes = document.querySelectorAll('.day-checkbox');
        dayCheckboxes.forEach(box => {
            const checkbox = box.querySelector('input[type="checkbox"]');
            box.addEventListener('click', function() {
                checkbox.checked = !checkbox.checked;
                box.classList.toggle('selected', checkbox.checked);
            });
        });

        // Specialization Tags
        const newSpecializationInput = document.getElementById('newSpecialization');
        const tagContainer = document.querySelector('.tag-container');

        newSpecializationInput.addEventListener('keypress', function(e) {
            if (e.key === 'Enter' && this.value.trim() !== '') {
                e.preventDefault();

                const tag = document.createElement('div');
                tag.className = 'tag';
                tag.innerHTML = `
                    ${this.value.trim()}
                    <button type="button" class="tag-remove">&times;</button>
                `;

                tagContainer.appendChild(tag);
                this.value = '';

                // Add remove functionality to new tag
                tag.querySelector('.tag-remove').addEventListener('click', function() {
                    tag.remove();
                });
            }
        });

        // Tag Remove Functionality
        document.querySelectorAll('.tag-remove').forEach(button => {
            button.addEventListener('click', function() {
                this.closest('.tag').remove();
            });
        });

        // Set default selections based on your model data
        @if (ViewBag.ServiceId != null)
        {
                <text>
                document.getElementById('Service_id').value = '@ViewBag.ServiceId';
                </text>
        }

        @if (ViewBag.ExperienceYears != null)
        {
                <text>
                document.getElementById('Experience_years').value = '@ViewBag.ExperienceYears';
                </text>
        }

        @if (ViewBag.LocationId != null)
        {
                <text>
                document.getElementById('Location_id').value = '@ViewBag.LocationId';
                </text>
        }
    });
</script>
<script>
    function toggleCustomExperience(select) {
        const container = document.getElementById('customExperienceContainer');
        if (select.value === 'custom') {
            container.style.display = 'block';
            document.getElementById('customExperience').required = true;
        } else {
            container.style.display = 'none';
            document.getElementById('customExperience').required = false;
        }
    }
</script>