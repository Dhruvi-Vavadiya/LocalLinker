@model LocalLinker.Models.users
@{
    ViewData["Title"] = "Forgot Password";
    Layout = null;
}



<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reset Password - LocalLinker</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
        :root {
            --primary: #4361ee;
            --primary-light: #eef2ff;
            --secondary: #7209b7;
            --success: #28a745;
            --danger: #dc3545;
            --warning: #ffc107;
            --dark: #212529;
            --light: #f8f9fa;
            --gray: #6c757d;
            --border-color: #dee2e6;
            --shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
            --radius: 12px;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .forgot-password-container {
            width: 100%;
            max-width: 450px;
            margin: 0 auto;
        }

        .forgot-card {
            background: white;
            border-radius: var(--radius);
            box-shadow: var(--shadow);
            padding: 40px;
            position: relative;
            overflow: hidden;
        }

            .forgot-card::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                height: 4px;
                background: linear-gradient(to right, var(--primary), var(--secondary));
            }

        .card-header {
            text-align: center;
            margin-bottom: 30px;
        }

        .logo-container {
            margin-bottom: 20px;
        }

        .logo-icon {
            width: 60px;
            height: 60px;
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 15px;
            color: white;
            font-size: 24px;
            box-shadow: 0 4px 15px rgba(67, 97, 238, 0.3);
        }

        .card-title {
            font-weight: 700;
            font-size: 28px;
            color: var(--dark);
            margin-bottom: 8px;
        }

        .card-subtitle {
            color: var(--gray);
            font-size: 14px;
            margin-bottom: 0;
        }

        .form-group {
            margin-bottom: 24px;
            position: relative;
        }

        .form-label {
            font-weight: 600;
            color: var(--dark);
            margin-bottom: 8px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .form-label i {
                color: var(--primary);
                font-size: 14px;
            }

        .form-control {
            padding: 14px 16px;
            border: 2px solid var(--border-color);
            border-radius: 8px;
            font-size: 15px;
            transition: all 0.3s ease;
            background: var(--light);
        }

            .form-control:focus {
                border-color: var(--primary);
                box-shadow: 0 0 0 3px rgba(67, 97, 238, 0.1);
                background: white;
            }

            .form-control.is-valid {
                border-color: var(--success);
                background: rgba(40, 167, 69, 0.05);
            }

            .form-control.is-invalid {
                border-color: var(--danger);
                background: rgba(220, 53, 69, 0.05);
            }

        .input-group {
            position: relative;
        }

        .password-toggle {
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            color: var(--gray);
            cursor: pointer;
            z-index: 10;
        }

        .validation-feedback {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 13px;
            margin-top: 6px;
            font-weight: 500;
        }

        .text-success {
            color: var(--success) !important;
        }

        .text-danger {
            color: var(--danger) !important;
        }

        .btn-submit {
            width: 100%;
            padding: 14px;
            background: linear-gradient(to right, var(--primary), var(--secondary));
            border: none;
            border-radius: 8px;
            color: white;
            font-weight: 600;
            font-size: 16px;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            margin-top: 10px;
        }

            .btn-submit:hover {
                transform: translateY(-2px);
                box-shadow: 0 6px 20px rgba(67, 97, 238, 0.3);
            }

            .btn-submit:active {
                transform: translateY(0);
            }

            .btn-submit:disabled {
                opacity: 0.6;
                cursor: not-allowed;
                transform: none !important;
            }

        .back-to-login {
            text-align: center;
            margin-top: 25px;
            padding-top: 20px;
            border-top: 1px solid var(--border-color);
        }

            .back-to-login a {
                color: var(--primary);
                text-decoration: none;
                font-weight: 500;
                display: inline-flex;
                align-items: center;
                gap: 6px;
                transition: color 0.3s ease;
            }

                .back-to-login a:hover {
                    color: var(--secondary);
                    text-decoration: underline;
                }

        .success-alert {
            background: rgba(40, 167, 69, 0.1);
            border: 1px solid rgba(40, 167, 69, 0.3);
            border-radius: 8px;
            padding: 15px;
            margin-bottom: 25px;
            display: flex;
            align-items: center;
            gap: 12px;
            animation: slideDown 0.5s ease;
        }

            .success-alert i {
                color: var(--success);
                font-size: 18px;
            }

            .success-alert p {
                margin: 0;
                color: var(--success);
                font-weight: 500;
            }

        .password-strength {
            margin-top: 8px;
        }

        .strength-meter {
            height: 4px;
            background: var(--border-color);
            border-radius: 2px;
            overflow: hidden;
            margin-bottom: 6px;
        }

        .strength-fill {
            height: 100%;
            width: 0;
            transition: all 0.3s ease;
            border-radius: 2px;
        }

        .strength-text {
            font-size: 12px;
            color: var(--gray);
            font-weight: 500;
        }

       

    </style>
</head>
<body>
    <div class="forgot-password-container">
        <div class="forgot-card">
            <div class="card-header">
                <div class="logo-container">
                    <div class="logo-icon">
                        <i class="fas fa-lock"></i>
                    </div>
                </div>
                <h2 class="card-title">Reset Password</h2>
                <p class="card-subtitle">Enter your email and new password to reset</p>
            </div>

            @if (TempData["Success"] != null)
            {
                <div class="success-alert">
                    <i class="fas fa-check-circle"></i>
                    <p>@TempData["Success"]</p>
                </div>
            }

            <form asp-action="ForgotPassword" method="post" id="forgotForm" novalidate>
                <div class="form-group">
                    <label asp-for="Email" class="form-label">
                        <i class="fas fa-envelope"></i> Email Address
                    </label>
                    <div class="input-group">
                        <input asp-for="Email"
                               class="form-control"
                               id="emailInput"
                               placeholder="Enter your email address"
                               required />
                        <div class="validation-feedback" id="email-feedback">
                            <span asp-validation-for="Email" class="text-danger"></span>
                            <span id="email-error" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <label asp-for="Password" class="form-label">
                        <i class="fas fa-key"></i> New Password
                    </label>
                    <div class="input-group">
                        <input asp-for="Password"
                               class="form-control"
                               id="passwordInput"
                               type="password"
                               placeholder="Enter new password"
                               required />
                        <button type="button" class="password-toggle" id="togglePassword">
                            <i class="fas fa-eye"></i>
                        </button>
                        <div class="password-strength">
                            <div class="strength-meter">
                                <div class="strength-fill" id="strengthFill"></div>
                            </div>
                            <div class="strength-text" id="strengthText">Password strength</div>
                        </div>
                        <div class="validation-feedback">
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <label asp-for="ConfirmPassword" class="form-label">
                        <i class="fas fa-key"></i> Confirm Password
                    </label>
                    <div class="input-group">
                        <input asp-for="ConfirmPassword"
                               class="form-control"
                               id="confirmPasswordInput"
                               type="password"
                               placeholder="Confirm new password"
                               required />
                        <button type="button" class="password-toggle" id="toggleConfirmPassword">
                            <i class="fas fa-eye"></i>
                        </button>
                        <div class="validation-feedback">
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                            <span id="confirm-error" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <button type="submit" class="btn-submit" id="submitBtn">
                    <i class="fas fa-sync-alt"></i> Update Password
                </button>
            </form>

            <div class="back-to-login">
                <a href="@Url.Action("Login", "Customer")">
                    <i class="fas fa-arrow-left"></i> Back to Login
                </a>
            </div>
        </div>
    </div>

    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>

    <!-- Bootstrap Bundle with Popper -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <!-- jQuery Validation Unobtrusive -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.3/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>

    <script>
        $(document).ready(function () {
            // Password visibility toggle
            $('#togglePassword').click(function() {
                const passwordInput = $('#passwordInput');
                const type = passwordInput.attr('type') === 'password' ? 'text' : 'password';
                passwordInput.attr('type', type);
                $(this).find('i').toggleClass('fa-eye fa-eye-slash');
            });

            $('#toggleConfirmPassword').click(function() {
                const confirmInput = $('#confirmPasswordInput');
                const type = confirmInput.attr('type') === 'password' ? 'text' : 'password';
                confirmInput.attr('type', type);
                $(this).find('i').toggleClass('fa-eye fa-eye-slash');
            });

            // Email validation with AJAX
            $('#emailInput').on('input', function () {
                const email = $(this).val().trim();
                const emailFeedback = $('#email-feedback');
                const emailError = $('#email-error');

                if (email) {
                    // Show loading state
                    emailError.html('<i class="fas fa-spinner fa-spin"></i> Verifying...').removeClass('text-success text-danger').addClass('text-warning');

                    $.ajax({
                        url: '@Url.Action("IsEmailExist", "Customer")',
                        type: 'POST',
                        data: { email: email },
                        success: function (response) {
                            if (response === false) {
                                emailError.html('<i class="fas fa-times-circle"></i> Email does not exist.').removeClass('text-success text-warning').addClass('text-danger');
                                $('#emailInput').removeClass('is-valid').addClass('is-invalid');
                                disableSubmit();
                            } else {
                                emailError.html('<i class="fas fa-check-circle"></i> Email verified').removeClass('text-danger text-warning').addClass('text-success');
                                $('#emailInput').removeClass('is-invalid').addClass('is-valid');
                                enableSubmit();
                            }
                        },
                        error: function () {
                            emailError.html('<i class="fas fa-exclamation-circle"></i> Server error').removeClass('text-success text-warning').addClass('text-danger');
                            $('#emailInput').addClass('is-invalid');
                            disableSubmit();
                        }
                    });
                } else {
                    emailError.text('');
                    $('#emailInput').removeClass('is-valid is-invalid');
                    disableSubmit();
                }
            });

            // Password strength meter
            $('#passwordInput').on('input', function() {
                const password = $(this).val();
                const strengthFill = $('#strengthFill');
                const strengthText = $('#strengthText');

                let strength = 0;
                let color = '#dc3545'; // Red
                let text = 'Weak';

                if (password.length >= 8) strength++;
                if (/[A-Z]/.test(password)) strength++;
                if (/[a-z]/.test(password)) strength++;
                if (/[0-9]/.test(password)) strength++;
                if (/[^A-Za-z0-9]/.test(password)) strength++;

                switch(strength) {
                    case 0:
                    case 1:
                        color = '#dc3545';
                        text = 'Weak';
                        break;
                    case 2:
                    case 3:
                        color = '#ffc107';
                        text = 'Medium';
                        break;
                    case 4:
                        color = '#28a745';
                        text = 'Strong';
                        break;
                    case 5:
                        color = '#20c997';
                        text = 'Very Strong';
                        break;
                }

                const width = (strength / 5) * 100;
                strengthFill.css({
                    'width': width + '%',
                    'background': color
                });
                strengthText.text(text).css('color', color);

                // Validate password match
                validatePasswordMatch();
            });

            // Confirm password validation
            $('#confirmPasswordInput').on('input', validatePasswordMatch);

            function validatePasswordMatch() {
                const password = $('#passwordInput').val();
                const confirm = $('#confirmPasswordInput').val();
                const confirmError = $('#confirm-error');

                if (confirm === '') {
                    confirmError.text('');
                    $('#confirmPasswordInput').removeClass('is-valid is-invalid');
                    return;
                }

                if (password === confirm) {
                    confirmError.html('<i class="fas fa-check-circle"></i> Passwords match').removeClass('text-danger').addClass('text-success');
                    $('#confirmPasswordInput').removeClass('is-invalid').addClass('is-valid');
                    enableSubmit();
                } else {
                    confirmError.html('<i class="fas fa-times-circle"></i> Passwords do not match').removeClass('text-success').addClass('text-danger');
                    $('#confirmPasswordInput').removeClass('is-valid').addClass('is-invalid');
                    disableSubmit();
                }
            }

            // Form submission
            $('#forgotForm').submit(function(e) {
                const emailValid = $('#emailInput').hasClass('is-valid');
                const confirmValid = $('#confirmPasswordInput').hasClass('is-valid');

                if (!emailValid || !confirmValid) {
                    e.preventDefault();
                    $('.form-control').addClass('shake');
                    setTimeout(() => {
                        $('.form-control').removeClass('shake');
                    }, 500);

                    // Focus on first invalid field
                    if (!emailValid) {
                        $('#emailInput').focus();
                    } else if (!confirmValid) {
                        $('#confirmPasswordInput').focus();
                    }

                    return false;
                }

                // Show loading state on submit button
                const submitBtn = $('#submitBtn');
                submitBtn.html('<i class="fas fa-spinner fa-spin"></i> Updating...').prop('disabled', true);
            });

            // Enable/disable submit button
            function enableSubmit() {
                const emailValid = $('#emailInput').hasClass('is-valid');
                const confirmValid = $('#confirmPasswordInput').hasClass('is-valid');
                $('#submitBtn').prop('disabled', !(emailValid && confirmValid));
            }

            function disableSubmit() {
                $('#submitBtn').prop('disabled', true);
            }

            // Initial state
            disableSubmit();
        });
    </script>
</body>
</html>