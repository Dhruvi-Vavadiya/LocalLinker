@model LocalLinker.Models.users
@{
    ViewData["Title"] = "Register";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<div class="container-fluid py-5" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); min-height: 100vh;">
    <div class="row justify-content-center align-items-center">
        <div class="col-xl-8 col-lg-10">
            <div class="card shadow-lg border-0 overflow-hidden">
                <div class="row g-0">
                    <!-- Left Side - Welcome/Illustration -->
                    <div class="col-lg-6 d-none d-lg-block">
                        <div class="h-100 p-5" style="background: linear-gradient(135deg, #6c63ff 0%, #4a44c6 100%);">
                            <div class="text-white text-center h-100 d-flex flex-column justify-content-center">
                                <div class="mb-5">
                                    <div class="display-5 mb-3">
                                        <i class="bi bi-person-plus-fill"></i>
                                    </div>
                                    <h2 class="fw-bold mb-3">Join Our Community</h2>
                                    <p class="opacity-90">
                                        Create your account to access exclusive features and connect with amazing services.
                                    </p>
                                </div>

                                <div class="mt-5">
                                    <div class="d-flex align-items-center justify-content-center mb-3">
                                        <i class="bi bi-shield-check fs-4 me-3"></i>
                                        <div class="text-start">
                                            <h6 class="mb-0">Secure Registration</h6>
                                            <small class="opacity-90">Your data is protected with encryption</small>
                                        </div>
                                    </div>
                                    <div class="d-flex align-items-center justify-content-center mb-3">
                                        <i class="bi bi-lightning-charge fs-4 me-3"></i>
                                        <div class="text-start">
                                            <h6 class="mb-0">Quick Setup</h6>
                                            <small class="opacity-90">Get started in less than 2 minutes</small>
                                        </div>
                                    </div>
                                    <div class="d-flex align-items-center justify-content-center">
                                        <i class="bi bi-people fs-4 me-3"></i>
                                        <div class="text-start">
                                            <h6 class="mb-0">Community Access</h6>
                                            <small class="opacity-90">Join thousands of satisfied users</small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Right Side - Registration Form -->
                    <div class="col-lg-6">
                        <div class="p-4 p-md-5">
                            <!-- Header -->
                            <div class="text-center mb-4">
                                <h3 class="fw-bold text-dark mb-1">Create Account</h3>
                                <p class="text-muted">Fill in your details to get started</p>
                            </div>

                            <form asp-action="Register" method="post" enctype="multipart/form-data" id="registerForm" novalidate>
                                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                                <!-- Profile Image Upload -->
                                <div class="text-center mb-4">
                                    <div class="position-relative d-inline-block">
                                        <div class="avatar-upload-register">
                                            <div class="avatar-preview-register">
                                                <img src="~/img/default.png"
                                                     class="rounded-circle shadow-sm"
                                                     width="100" height="100"
                                                     id="registerImagePreview"
                                                     alt="Profile preview" />
                                            </div>
                                            <div class="avatar-edit-register">
                                                <input type="file"
                                                       name="ImageFile"
                                                       id="registerImageUpload"
                                                       accept="image/*"
                                                       class="d-none" />
                                                <label for="registerImageUpload"
                                                       class="btn btn-primary btn-sm rounded-circle shadow"
                                                       style="width: 32px; height: 32px;"
                                                       data-bs-toggle="tooltip"
                                                       title="Upload photo">
                                                    <i class="bi bi-camera"></i>
                                                </label>
                                            </div>
                                        </div>
                                    </div>
                                    <p class="text-muted small mt-2">Optional: Add a profile picture</p>
                                </div>

                                <!-- Form Fields -->
                                <div class="row g-3">
                                    <!-- Full Name -->
                                    <div class="col-12">
                                        <div class="form-floating">
                                            <input asp-for="Name"
                                                   class="form-control"
                                                   placeholder="Full Name"
                                                   id="registerName" />
                                            <label for="registerName">
                                                <i class="bi bi-person me-2"></i>Full Name
                                            </label>
                                            <span asp-validation-for="Name" class="text-danger small mt-1"></span>
                                        </div>
                                    </div>

                                    <!-- Email -->
                                    <div class="col-12">
                                        <div class="form-floating">
                                            <input asp-for="Email"
                                                   type="email"
                                                   class="form-control"
                                                   placeholder="Email Address"
                                                   id="registerEmail" />
                                            <label for="registerEmail">
                                                <i class="bi bi-envelope me-2"></i>Email Address
                                            </label>
                                            <span asp-validation-for="Email" class="text-danger small mt-1"></span>
                                        </div>
                                    </div>

                                    <!-- Phone -->
                                    <div class="col-12">
                                        <div class="form-floating">
                                            <input asp-for="Phone"
                                                   class="form-control"
                                                   placeholder="Phone Number"
                                                   id="registerPhone" />
                                            <label for="registerPhone">
                                                <i class="bi bi-phone me-2"></i>Phone Number
                                            </label>
                                            <span asp-validation-for="Phone" class="text-danger small mt-1"></span>
                                        </div>
                                    </div>

                                    <!-- Password -->
                                    <div class="col-12">
                                        <div class="form-floating">
                                            <input asp-for="Password"
                                                   type="password"
                                                   class="form-control"
                                                   placeholder="Password"
                                                   id="registerPassword"
                                                   data-bs-toggle="tooltip"
                                                   title="Minimum 8 characters with letters and numbers" />
                                            <label for="registerPassword">
                                                <i class="bi bi-lock me-2"></i>Password
                                            </label>
                                            <div class="password-strength mt-2">
                                                <div class="progress" style="height: 4px;">
                                                    <div class="progress-bar" id="passwordStrength" style="width: 0%"></div>
                                                </div>
                                                <small class="text-muted" id="passwordHint"></small>
                                            </div>
                                            <span asp-validation-for="Password" class="text-danger small mt-1"></span>
                                        </div>
                                    </div>

                                    <!-- Confirm Password -->
                                    <div class="col-12">
                                        <div class="form-floating">
                                            <input asp-for="ConfirmPassword"
                                                   type="password"
                                                   class="form-control"
                                                   placeholder="Confirm Password"
                                                   id="registerConfirmPassword" />
                                            <label for="registerConfirmPassword">
                                                <i class="bi bi-lock-fill me-2"></i>Confirm Password
                                            </label>
                                            <span asp-validation-for="ConfirmPassword" class="text-danger small mt-1"></span>
                                            <div class="mt-2" id="passwordMatch"></div>
                                        </div>
                                    </div>

                                    <!-- User Type -->
                                    <div class="col-12">
                                        <div class="form-floating">
                                            <select asp-for="UserType"
                                                    class="form-select"
                                                    id="registerUserType">
                                                <option value="">-- Select Role --</option>
                                                <option value="Customer">Customer</option>
                                                <option value="Provider">Service Provider</option>
                                                <option value="Admin">Administrator</option>
                                            </select>
                                            <label for="registerUserType">
                                                <i class="bi bi-person-badge me-2"></i>Account Type
                                            </label>
                                            <span asp-validation-for="UserType" class="text-danger small mt-1"></span>
                                        </div>
                                    </div>

                                    <!-- Terms and Conditions -->
                                    <div class="col-12">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" id="termsCheck" required>
                                            <label class="form-check-label small" for="termsCheck">
                                                I agree to the <a href="#" class="text-decoration-none">Terms of Service</a>
                                                and <a href="#" class="text-decoration-none">Privacy Policy</a>
                                            </label>
                                        </div>
                                    </div>
                                </div>

                                <!-- Submit Button -->
                                <div class="d-grid mt-4">
                                    <button type="submit"
                                            class="btn btn-lg btn-primary"
                                            id="registerSubmit">
                                        <span class="spinner-border spinner-border-sm d-none me-2" id="registerSpinner"></span>
                                        <i class="bi bi-person-plus me-2"></i>Create Account
                                    </button>
                                </div>

                                @if (ViewBag.ErrorMessage != null)
                                {
                                    <div class="alert alert-danger alert-dismissible fade show mt-3" role="alert">
                                        <i class="bi bi-exclamation-triangle me-2"></i>@ViewBag.ErrorMessage
                                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                                    </div>
                                }

                                <!-- Divider -->
                                <div class="text-center my-4">
                                    <span class="text-muted">or sign up with</span>
                                </div>

                                <!-- Social Login -->
                                <div class="row g-2 mb-4">
                                    <div class="col">
                                        <button type="button" class="btn btn-outline-primary w-100">
                                            <i class="bi bi-google me-2"></i>Google
                                        </button>
                                    </div>
                                    <div class="col">
                                        <button type="button" class="btn btn-outline-dark w-100">
                                            <i class="bi bi-github me-2"></i>GitHub
                                        </button>
                                    </div>
                                </div>
                            </form>

                            <!-- Login Link -->
                            <div class="text-center mt-4 pt-3 border-top">
                                <p class="text-muted mb-0">
                                    Already have an account?
                                    <a href="@Url.Action("Login", "Customer")" class="text-decoration-none fw-bold">
                                        Sign In Now
                                    </a>
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Success Modal -->
<div class="modal fade" id="successModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-body text-center p-5">
                <div class="display-1 text-success mb-4">
                    <i class="bi bi-check-circle-fill"></i>
                </div>
                <h4 class="mb-3">Registration Successful!</h4>
                <p class="text-muted mb-4">
                    Your account has been created successfully. Redirecting to login page...
                </p>
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .card {
        border-radius: 20px;
        overflow: hidden;
    }

    .form-floating > .form-control,
    .form-floating > .form-select {
        height: calc(3.5rem + 2px);
        line-height: 1.25;
        padding: 1rem 0.75rem;
    }

    .form-floating > label {
        padding: 1rem 0.75rem;
    }

    .form-control:focus,
    .form-select:focus {
        border-color: #6c63ff;
        box-shadow: 0 0 0 0.25rem rgba(108, 99, 255, 0.25);
    }

    .avatar-upload-register {
        position: relative;
        display: inline-block;
    }

    .avatar-edit-register {
        position: absolute;
        right: 0;
        bottom: 0;
        z-index: 1;
    }

    .avatar-preview-register img {
        width: 100px;
        height: 100px;
        object-fit: cover;
        border: 3px solid #fff;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }

    .btn-primary {
        background: linear-gradient(135deg, #6c63ff 0%, #4a44c6 100%);
        border: none;
        transition: all 0.3s ease;
    }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(108, 99, 255, 0.4);
        }

    .btn-outline-primary:hover {
        background: linear-gradient(135deg, #6c63ff 0%, #4a44c6 100%);
        color: white;
        border: none;
    }

    .password-strength .progress-bar {
        transition: width 0.3s ease;
    }

    .form-check-input:checked {
        background-color: #6c63ff;
        border-color: #6c63ff;
    }
</style>

@section Scripts {
    <script>
        // Image preview for registration
        document.getElementById('registerImageUpload').addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (file) {
                if (file.size > 5 * 1024 * 1024) {
                    alert('File size must be less than 5MB');
                    return;
                }

                const reader = new FileReader();
                reader.onload = function(e) {
                    document.getElementById('registerImagePreview').src = e.target.result;
                }
                reader.readAsDataURL(file);
            }
        });

        // Password strength indicator
        document.getElementById('registerPassword').addEventListener('input', function(e) {
            const password = e.target.value;
            const strengthBar = document.getElementById('passwordStrength');
            const hint = document.getElementById('passwordHint');

            let strength = 0;
            let message = '';
            let color = '';

            if (password.length >= 8) strength += 25;
            if (/[A-Z]/.test(password)) strength += 25;
            if (/[0-9]/.test(password)) strength += 25;
            if (/[^A-Za-z0-9]/.test(password)) strength += 25;

            strengthBar.style.width = strength + '%';

            if (strength < 25) {
                color = '#dc3545';
                message = 'Very Weak';
            } else if (strength < 50) {
                color = '#ffc107';
                message = 'Weak';
            } else if (strength < 75) {
                color = '#17a2b8';
                message = 'Good';
            } else {
                color = '#28a745';
                message = 'Strong';
            }

            strengthBar.style.backgroundColor = color;
            hint.textContent = message;
            hint.style.color = color;
        });

        // Password match validation
        document.getElementById('registerConfirmPassword').addEventListener('input', function(e) {
            const password = document.getElementById('registerPassword').value;
            const confirmPassword = e.target.value;
            const matchDiv = document.getElementById('passwordMatch');

            if (confirmPassword === '') {
                matchDiv.innerHTML = '';
                return;
            }

            if (password === confirmPassword) {
                matchDiv.innerHTML = '<small class="text-success"><i class="bi bi-check-circle me-1"></i>Passwords match</small>';
            } else {
                matchDiv.innerHTML = '<small class="text-danger"><i class="bi bi-x-circle me-1"></i>Passwords do not match</small>';
            }
        });

        // Form submission
        document.getElementById('registerForm').addEventListener('submit', function(e) {
            const submitBtn = document.getElementById('registerSubmit');
            const spinner = document.getElementById('registerSpinner');

            // Show loading state
            submitBtn.disabled = true;
            spinner.classList.remove('d-none');

            // Validate terms
            if (!document.getElementById('termsCheck').checked) {
                e.preventDefault();
                alert('Please accept the Terms of Service');
                submitBtn.disabled = false;
                spinner.classList.add('d-none');
                return;
            }

            // Validate password match
            const password = document.getElementById('registerPassword').value;
            const confirmPassword = document.getElementById('registerConfirmPassword').value;

            if (password !== confirmPassword) {
                e.preventDefault();
                alert('Passwords do not match');
                submitBtn.disabled = false;
                spinner.classList.add('d-none');
                return;
            }

            // If validation passes, form will submit normally
            // You could add AJAX submission here if needed
        });

        // Initialize tooltips
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
        var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl);
        });

        // Phone number formatting
        document.getElementById('registerPhone').addEventListener('input', function(e) {
            let value = e.target.value.replace(/\D/g, '');
            if (value.length > 10) value = value.substr(0, 10);
            if (value.length > 6) {
                value = `(${value.substr(0,3)}) ${value.substr(3,3)}-${value.substr(6)}`;
            } else if (value.length > 3) {
                value = `(${value.substr(0,3)}) ${value.substr(3)}`;
            } else if (value.length > 0) {
                value = `(${value}`;
            }
            e.target.value = value;
        });
    </script>
}